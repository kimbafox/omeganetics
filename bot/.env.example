# Copia este archivo a "bot/.env" y rellena los valores. NUNCA subas .env a internet.

# Token del bot (Discord Developer Portal -> tu aplicación -> Bot -> Reset Token)
DISCORD_TOKEN=pega_aqui_tu_token

# ID de tu servidor de Discord (clic derecho sobre el servidor -> "Copiar ID de servidor"
# con el Modo desarrollador activado en Ajustes -> Avanzado)
GUILD_ID=pega_aqui_el_id_del_servidor

# Puerto local de la API (opcional)
PORT=3001
